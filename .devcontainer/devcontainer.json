// File responsible for creating the Docker container for the QoQo Quantum Cryptography simulation environment 
// (devcontainer) and linking it with Visual Studio Code to easily write Python code and run Jupyter Notebooks.

{
    "name": "QoQo Quantum Cryptography Docker",
    "dockerComposeFile": "docker-compose.yml",
    "service": "qoqo-quantum-cryptography-docker",
    "mounts": [
        "source=${localWorkspaceFolder}/volume_docker_files,target=/volume_docker_files,type=bind"
      ],
    "workspaceFolder": "/volume_docker_files", // The working folder in the container must be an absolute path
    "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",  // Python Extension
        "ms-toolsai.jupyter", // Support for Jupyter Notebooks
        "esbenp.prettier-vscode" // Prettier for code formatting
        ]
      }
    }
}
  